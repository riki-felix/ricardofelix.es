---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <header class="header">
      <h1>Ricardo Félix</h1>
	  <p class="description">Almanaque.<br>Curiosidades,<br>momentos<br>y experiencias.</p>
    </header>

    <div class="weeks" id="weeks">
      <small class="grid__empty" id="grid-empty">Buscando…</small>
    </div>
  </main>
</Layout>

<script>
  interface ImageEntry {
    key: string;
    date: string;
    caption?: string;
    location?: string;
  }

  const isAdmin = new URLSearchParams(window.location.search).has('admin');
  const isLocal = window.location.hostname === 'localhost';
  const api = isLocal ? 'https://www.ricardofelix.es' : '';
  let token: string | null = null;

  // Admin mode: require secret before showing anything
  if (isAdmin) {
    token = sessionStorage.getItem('upload_secret');
    if (!token) {
      token = prompt('Secret:');
      if (token) {
        sessionStorage.setItem('upload_secret', token);
      } else {
        // No secret → redirect to public view
        window.location.href = '/';
      }
    }
  }

  async function deleteImage(key: string, figure: HTMLElement) {
    if (!token) return;
    if (!confirm('¿Eliminar esta imagen?')) return;

    const res = await fetch(`${api}/api/image?key=${encodeURIComponent(key)}`, {
      method: 'DELETE',
      headers: { Authorization: `Bearer ${token}` },
    });

    if (res.ok) {
      figure.remove();
    } else if (res.status === 401) {
      sessionStorage.removeItem('upload_secret');
      alert('Secret incorrecto');
      window.location.reload();
    } else {
      alert('Error al eliminar');
    }
  }

  const meses: Record<string, number> = {
    ene:0, feb:1, mar:2, abr:3, may:4, jun:5,
    jul:6, ago:7, sept:8, sep:8, oct:9, nov:10, dic:11
  };

  function parseDate(s: string): Date | null {
    if (!s) return null;
    // Try ISO first
    let d = new Date(s);
    if (!isNaN(d.getTime())) return d;
    // Parse Spanish format: "3 ene 2025, 10:44"
    const m = s.match(/^(\d{1,2})\s+(\w+)\s+(\d{4}),?\s*(\d{1,2}):(\d{2})$/);
    if (m) {
      const mon = meses[m[2].toLowerCase()];
      if (mon != null) {
        return new Date(+m[3], mon, +m[1], +m[4], +m[5]);
      }
    }
    return null;
  }

  function getWeekKey(dateStr: string): string {
    const d = parseDate(dateStr);
    if (!d) return 'unknown';
    // ISO week: Monday-based
    const tmp = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
    const dayNum = tmp.getUTCDay() || 7;
    tmp.setUTCDate(tmp.getUTCDate() + 4 - dayNum);
    const yearStart = new Date(Date.UTC(tmp.getUTCFullYear(), 0, 1));
    const weekNo = Math.ceil(((tmp.getTime() - yearStart.getTime()) / 864e5 + 1) / 7);
    return `${tmp.getUTCFullYear()}-W${String(weekNo).padStart(2, '0')}`;
  }

  async function loadImages() {
    const container = document.getElementById('weeks')!;
    const empty = document.getElementById('grid-empty')!;

    try {
      const res = await fetch(`${api}/api/images`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const images: ImageEntry[] = await res.json();

      if (images.length === 0) {
        empty.textContent = '';
        return;
      }

      empty.remove();

      // Group by week
      const weeks = new Map<string, ImageEntry[]>();
      for (const img of images) {
        const wk = getWeekKey(img.date);
        if (!weeks.has(wk)) weeks.set(wk, []);
        weeks.get(wk)!.push(img);
      }

      for (const [, weekImages] of weeks) {
        const section = document.createElement('section');
        section.className = 'week-grid';
        // Set column count based on number of images this week
        section.style.setProperty('--week-cols', String(Math.min(weekImages.length, 4)));

        for (const img of weekImages) {
          const figure = document.createElement('figure');
          figure.className = 'grid__item';

          const imgEl = document.createElement('img');
          imgEl.src = `${api}/api/image?key=${encodeURIComponent(img.key)}`;
          imgEl.alt = img.caption || '';
          imgEl.loading = 'lazy';
          imgEl.decoding = 'async';
          imgEl.crossOrigin = 'anonymous';
          figure.appendChild(imgEl);

          if (img.caption || img.location || img.date) {
            const caption = document.createElement('figcaption');
            const parts: string[] = [];
            if (img.caption) parts.push(img.caption);
            if (img.location) {
              const cpMatch = img.location.match(/\b\d{5}\b/);
              if (cpMatch) parts.push(cpMatch[0]);
            }
            if (img.date) {
              const d = parseDate(img.date);
              if (d) {
                const hh = d.getHours();
                const mm = String(d.getMinutes()).padStart(2, '0');
                const dd = d.getDate();
                const mo = d.getMonth() + 1;
                const yy = d.getFullYear();
                parts.push(`${hh}:${mm} ${dd}/${mo}/${yy}`);
              }
            }
            caption.textContent = parts.join(' — ');
            figure.appendChild(caption);
          }

          if (isAdmin) {
            const btn = document.createElement('button');
            btn.className = 'grid__delete';
            btn.textContent = '×';
            btn.title = 'Eliminar imagen';
            btn.addEventListener('click', () => deleteImage(img.key, figure));
            figure.appendChild(btn);
          }

          section.appendChild(figure);
        }

        container.appendChild(section);
      }
    } catch {
      empty.textContent = '';
    }
  }

  if (!isAdmin || token) loadImages();
</script>

<style>
  main {
    padding: 1rem;
  }

  .header {
	position: fixed;
	top: 0;
	bottom: 0;
	left: 0.5rem;
	height: 100dvh;
	display: flex;
	flex-flow: column nowrap;

}

.header h1 {
	font-size: 2rem;
	font-weight: 300;
    margin-bottom: 0.25rem;
}

	.description {
		margin-top: auto;
		padding-bottom: 1rem;
	}
	p {
	  font-size: 2rem;
	  line-height: 1;
  }

  .weeks {
    margin-top: 6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .grid__empty {
    color: var(--color-muted);
  }
</style>

<style is:global>
  .week-grid {
    display: grid;
    grid-template-columns: repeat(var(--week-cols, 1), minmax(0, 320px));
    gap: 2px;
    justify-content: center;
    @media (min-width: 750px) {
      grid-template-columns: repeat(var(--week-cols, 1), minmax(0, 500px)); 
    }
  }
  .grid__item {
    overflow: hidden;
    background: var(--color-card-bg);
    position: relative;
  }

  .grid__item img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    transition: opacity 0.3s;
}

.grid__item figcaption {
	padding: 0 6px;
    font-size: 1rem;
	position: absolute;
	bottom: 0;
	right: 0;
	color: rgba(255, 255, 255, 1);
}

  .grid__delete {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    width: 1.8rem;
    height: 1.8rem;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .grid__delete:hover {
    background: rgba(200, 0, 0, 0.8);
  }
</style>
