---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <header class="header">
      <h1>Ricardo Félix</h1>
      <p>Bien.</p>
    </header>

    <section class="grid" id="grid">
      <small class="grid__empty" id="grid-empty">Buscando…</small>
    </section>
  </main>
</Layout>

<script>
  interface ImageEntry {
    key: string;
    date: string;
    caption?: string;
    location?: string;
  }

  const isAdmin = new URLSearchParams(window.location.search).has('admin');
  const isLocal = window.location.hostname === 'localhost';
  const api = isLocal ? 'https://www.ricardofelix.es' : '';
  let token: string | null = null;

  // Admin mode: require secret before showing anything
  if (isAdmin) {
    token = sessionStorage.getItem('upload_secret');
    if (!token) {
      token = prompt('Secret:');
      if (token) {
        sessionStorage.setItem('upload_secret', token);
      } else {
        // No secret → redirect to public view
        window.location.href = '/';
      }
    }
  }

  async function deleteImage(key: string, figure: HTMLElement) {
    if (!token) return;
    if (!confirm('¿Eliminar esta imagen?')) return;

    const res = await fetch(`${api}/api/image?key=${encodeURIComponent(key)}`, {
      method: 'DELETE',
      headers: { Authorization: `Bearer ${token}` },
    });

    if (res.ok) {
      figure.remove();
    } else if (res.status === 401) {
      sessionStorage.removeItem('upload_secret');
      alert('Secret incorrecto');
      window.location.reload();
    } else {
      alert('Error al eliminar');
    }
  }

  async function loadImages() {
    const grid = document.getElementById('grid')!;
    const empty = document.getElementById('grid-empty')!;

    try {
      const res = await fetch(`${api}/api/images`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const images: ImageEntry[] = await res.json();

      if (images.length === 0) {
        empty.textContent = '';
        return;
      }

      empty.remove();

      for (const img of images) {
        const figure = document.createElement('figure');
        figure.className = 'grid__item';

        const imgEl = document.createElement('img');
        imgEl.src = `${api}/api/image?key=${encodeURIComponent(img.key)}`;
        imgEl.alt = img.caption || '';
        imgEl.loading = 'lazy';
        imgEl.decoding = 'async';
        imgEl.crossOrigin = 'anonymous';
        figure.appendChild(imgEl);

        if (img.caption || img.location || img.date) {
          const caption = document.createElement('figcaption');
          const parts: string[] = [];
          if (img.caption) parts.push(img.caption);
          if (img.location) {
            const cpMatch = img.location.match(/\b\d{5}\b/);
            if (cpMatch) parts.push(cpMatch[0]);
          }
          if (img.date) {
            const d = new Date(img.date);
            if (!isNaN(d.getTime())) {
              parts.push(d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }));
            }
          }
          caption.textContent = parts.join(' — ');
          figure.appendChild(caption);

          imgEl.addEventListener('load', () => {
            try {
              const canvas = document.createElement('canvas');
              const ctx = canvas.getContext('2d');
              if (!ctx) return;
              // Draw only the bottom 15% scaled to 1×1 — browser averages all pixels for us
              const sy = Math.floor(imgEl.naturalHeight * 0.85);
              const sh = imgEl.naturalHeight - sy;
              canvas.width = 1;
              canvas.height = 1;
              ctx.drawImage(imgEl, 0, sy, imgEl.naturalWidth, sh, 0, 0, 1, 1);
              const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
              const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
              const shift = 120;
              caption.style.color = lum > 0.5
                ? `rgb(${Math.max(r - shift, 0)}, ${Math.max(g - shift, 0)}, ${Math.max(b - shift, 0)})`
                : `rgb(${Math.min(r + shift, 255)}, ${Math.min(g + shift, 255)}, ${Math.min(b + shift, 255)})`;
            } catch { /* CORS or canvas error — keep default color */ }
          });
        }

        if (isAdmin) {
          const btn = document.createElement('button');
          btn.className = 'grid__delete';
          btn.textContent = '×';
          btn.title = 'Eliminar imagen';
          btn.addEventListener('click', () => deleteImage(img.key, figure));
          figure.appendChild(btn);
        }

        grid.appendChild(figure);
      }
    } catch {
      empty.textContent = '';
    }
  }

  if (!isAdmin || token) loadImages();
</script>

<style>
  main {
    padding: 1rem;
  }

  .header {
	position: fixed;
	top: 0;
	left: 0.5rem;
  }

  .header h1 {
    font-size: 2rem;
	font-weight: 300;
    margin-bottom: 0.25rem;
  }

  .header p {}

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2px;
	margin-top: 6rem;
  }

  .grid__empty {
    grid-column: 1 / -1;
    color: #999;
  }
</style>

<style is:global>
  .grid__item {
    overflow: hidden;
    background: #eee;
    position: relative;
  }

  .grid__item img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    transition: opacity 0.3s;
}

.grid__item figcaption {
	padding: 0 6px;
    font-size: 1rem;
	position: absolute;
	bottom: 0;
	right: 0;
	color: rgba(255, 255, 255, 0.8);
}

  .grid__delete {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    width: 1.8rem;
    height: 1.8rem;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .grid__delete:hover {
    background: rgba(200, 0, 0, 0.8);
  }
</style>
