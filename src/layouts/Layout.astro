---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ricardo Félix',
  description = 'Bien.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ricardo Félix" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />

    <!-- Fonts.net -->
    <link rel="preconnect" href="https://cdn.fonts.net" />
    <script type="text/javascript" src="https://cdn.fonts.net/kit/edd6b279-8438-4a90-b239-dc655ce0159d/edd6b279-8438-4a90-b239-dc655ce0159d_enhanced.js" async></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.fonts.net/kit/edd6b279-8438-4a90-b239-dc655ce0159d/edd6b279-8438-4a90-b239-dc655ce0159d_enhanced.css" />

    <!-- Daylight theme: sets data-theme on <html> before first paint -->
    <script is:inline>
    (function(){
      // Timezone → approximate latitude lookup
      var zones={
        'Pacific/Honolulu':21,'America/Anchorage':61,'America/Los_Angeles':34,
        'America/Denver':40,'America/Chicago':42,'America/New_York':41,
        'America/Toronto':44,'America/Halifax':45,'America/Sao_Paulo':-23,
        'America/Argentina/Buenos_Aires':-35,'America/Mexico_City':19,
        'America/Bogota':5,'America/Lima':-12,'America/Santiago':-33,
        'Atlantic/Reykjavik':64,'Europe/London':51,'Europe/Dublin':53,
        'Europe/Paris':49,'Europe/Madrid':40,'Europe/Berlin':52,
        'Europe/Rome':42,'Europe/Amsterdam':52,'Europe/Brussels':51,
        'Europe/Zurich':47,'Europe/Stockholm':59,'Europe/Oslo':60,
        'Europe/Helsinki':60,'Europe/Warsaw':52,'Europe/Prague':50,
        'Europe/Vienna':48,'Europe/Athens':38,'Europe/Istanbul':41,
        'Europe/Moscow':56,'Europe/Lisbon':39,
        'Africa/Cairo':30,'Africa/Lagos':6,'Africa/Johannesburg':-26,
        'Africa/Nairobi':-1,'Africa/Casablanca':34,
        'Asia/Dubai':25,'Asia/Kolkata':19,'Asia/Bangkok':14,
        'Asia/Shanghai':31,'Asia/Tokyo':36,'Asia/Seoul':38,
        'Asia/Singapore':1,'Asia/Hong_Kong':22,'Asia/Jakarta':-6,
        'Australia/Sydney':-34,'Australia/Melbourne':-38,
        'Australia/Perth':-32,'Pacific/Auckland':-37
      };

      var tz='';
      try{tz=Intl.DateTimeFormat().resolvedOptions().timeZone}catch(e){}
      var lat=zones[tz];
      if(lat==null){
        // Try continent match
        var cont=tz.split('/')[0];
        if(cont==='Europe')lat=48;
        else if(cont==='America')lat=35;
        else if(cont==='Asia')lat=30;
        else if(cont==='Africa')lat=10;
        else if(cont==='Australia')lat=-30;
        else lat=40;
      }

      // Solar calculation (simplified sunrise/sunset)
      var now=new Date();
      var start=new Date(now.getFullYear(),0,1);
      var doy=Math.floor((now-start)/864e5)+1;
      var rad=Math.PI/180;
      // Declination angle
      var decl=23.45*Math.sin(rad*(360/365)*(doy-81));
      // Hour angle
      var cosH=-Math.tan(lat*rad)*Math.tan(decl*rad);
      // Detect DST: compare current offset vs standard offset
      var jan=new Date(now.getFullYear(),0,1);
      var jul=new Date(now.getFullYear(),6,1);
      var stdOffset=Math.max(jan.getTimezoneOffset(),jul.getTimezoneOffset());
      var dstShift=now.getTimezoneOffset()<stdOffset?(stdOffset-now.getTimezoneOffset())/60:0;

      var isDark;
      if(cosH<=-1){isDark=false}// midnight sun
      else if(cosH>=1){isDark=true}// polar night
      else{
        var H=Math.acos(cosH)/rad;
        var sunrise=12-H/15+dstShift;
        var sunset=12+H/15+dstShift;
        var hour=now.getHours()+now.getMinutes()/60;
        isDark=hour<sunrise||hour>sunset;
      }

      document.documentElement.setAttribute('data-theme',isDark?'dark':'light');
    })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html[data-theme='light'] {
    --color-text: #2b2b2b;
    --color-bg: #eceae8;
    --color-muted: #999;
    --color-card-bg: #e0dedc;
  }

  html[data-theme='dark'] {
    --color-text: #e0dedc;
    --color-bg: #1a1a1a;
    --color-muted: #777;
    --color-card-bg: #2a2a2a;
  }

  html {
    color: var(--color-text);
    font-family: 'BentonModernD', Georgia, serif;
    font-style: normal;
    font-stretch: extra-condensed;
    font-weight: 300;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100dvh;
    background-color: var(--color-bg);
    transition: background-color 0.3s, color 0.3s;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
